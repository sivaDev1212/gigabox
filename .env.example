# Copy to backend/.env for local development:
#   cp .env.example backend/.env

NODE_ENV=development
PORT=3000

# Local Postgres started by docker compose. Inside the backend container this host is "postgres".
DATABASE_URL=postgresql://gigabox:gigabox@localhost:5432/gigabox?schema=public
TEST_DATABASE_URL=postgresql://gigabox:gigabox@localhost:5432/gigabox_test?schema=public

# Frontend dev server origin. Comma-separate multiple origins if needed.
CORS_ORIGIN=http://localhost:5173

# POST /api/orders rate limit per IP.
ORDER_RATE_LIMIT_WINDOW_MS=60000
ORDER_RATE_LIMIT_MAX=20

# Optional bonuses. Leave REDIS_URL empty to run without Redis.
REDIS_URL=
AUTO_CANCEL_MINUTES=5

# Set to true to wipe and recreate seed data.
SEED_FORCE=false
